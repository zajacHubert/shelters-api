{
  "info": {
    "name": "Shelters API",
    "_postman_id": "shelters-api-collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Kolekcja do testowania Shelters API.\n\nKolejność wykonania dla happy-path:\n1. Shelters / Create Shelter\n2. Needs / Create Need - Pilne\n3. Needs / Create Need - Umiarkowane\n4. Needs / Create Need - Bez pośpiechu\n5. Pozostałe requesty GET/PATCH/DELETE"
  },
  "variable": [
    { "key": "baseUrl",   "value": "http://localhost:3000", "type": "string" },
    { "key": "shelterId", "value": "",                      "type": "string" },
    { "key": "needId",    "value": "",                      "type": "string" }
  ],
  "item": [
    {
      "name": "Shelters",
      "item": [
        {
          "name": "Create Shelter (adres dostawy taki sam)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status 201', () => pm.response.to.have.status(201));",
                "pm.test('Has id', () => {",
                "  const json = pm.response.json();",
                "  pm.expect(json).to.have.property('id');",
                "  pm.collectionVariables.set('shelterId', json.id);",
                "});",
                "pm.test('deliverySameAsAddress is true', () => {",
                "  pm.expect(pm.response.json().deliverySameAsAddress).to.be.true;",
                "});"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/shelters", "host": ["{{baseUrl}}"], "path": ["shelters"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Schronisko Na Paluchu\",\n  \"phoneNumber\": \"+48501234567\",\n  \"address\": {\n    \"postalCode\": \"02-159\",\n    \"city\": \"Warszawa\",\n    \"street\": \"ul. Paluch\",\n    \"houseNumber\": \"2\"\n  },\n  \"deliverySameAsAddress\": true\n}"
            }
          }
        },
        {
          "name": "Create Shelter (osobny adres dostawy)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
