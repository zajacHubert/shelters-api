                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Shelter by ID",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status 200', () => pm.response.to.have.status(200));",
